#!/usr/bin/env python3
"""
Shared inference client for Barrot.

Centralizes provider credentials and OpenAI-compatible chat requests.
Existing scripts can migrate here incrementally.
"""

from __future__ import annotations

import json
import os
import urllib.error
import urllib.request
from typing import Any


class InferenceError(RuntimeError):
    pass


def _env(name: str) -> str:
    return os.getenv(name, "").strip()


def _normalize_base_url(endpoint: str) -> str:
    """Keep explicit OpenAI-compatible URLs intact while normalizing Astra endpoints."""
    base = endpoint.strip().rstrip("/")
    if not base:
        return base
    if "/chat/completions" in base:
        return base.rsplit("/chat/completions", 1)[0]
    if "/v1" in base:
        return base
    if "/api/inference" in base:
        return base
    return base + "/v1"


def get_provider() -> dict[str, str]:
    """Return the first configured inference provider, defaulting to Astra."""

    preferred = (_env("BRAIN_PRIMARY") or "astra").lower()

    astra_key = (
        _env("ASTRA_API_KEY")
        or _env("ASTRA_DB_APPLICATION_TOKEN")
        or _env("ASTRA_INFERENCE_API_KEY")
        or _env("ASTRA_KEY")
    )
    astra_endpoint = (
        _env("ASTRA_OPENAI_BASE_URL")
        or _env("ASTRA_API_ENDPOINT")
        or _env("ASTRA_INFERENCE_ENDPOINT")
        or _env("ASTRA_DB_API_ENDPOINT")
    )
    if astra_key and astra_endpoint:
        if preferred in {"", "astra"}:
            return {
                "name": "astra",
                "api_key": astra_key,
                "base_url": _normalize_base_url(astra_endpoint),
                "default_model": (
                    _env("ASTRA_MODEL")
                    or _env("ASTRA_MODEL_NAME")
                    or _env("ASTRA_INFERENCE_MODEL")
                    or _env("MODEL_ID")
                    or "gpt-4o-mini"
                ),
            }

    groq_key = _env("GROQ_API_KEY")
    if preferred in {"", "groq"} and groq_key:
        return {
            "name": "groq",
            "api_key": groq_key,
            "base_url": "https://api.groq.com/openai/v1",
            "default_model": _env("GROQ_MODEL") or "openai/gpt-oss-120b",
        }

    fireworks_key = _env("FIREWORKS_API_KEY")
    if preferred in {"", "fireworks"} and fireworks_key:
        return {
            "name": "fireworks",
            "api_key": fireworks_key,
            "base_url": _env("FIREWORKS_BASE_URL")
            or "https://api.fireworks.ai/inference/v1",
            "default_model": _env("FIREWORKS_MODEL") or "accounts/fireworks/models/llama-v3p3-70b-instruct",
        }

    if astra_key and astra_endpoint:
        return {
            "name": "astra",
            "api_key": astra_key,
            "base_url": _normalize_base_url(astra_endpoint),
            "default_model": (
                _env("ASTRA_MODEL")
                or _env("ASTRA_MODEL_NAME")
                or _env("ASTRA_INFERENCE_MODEL")
                or _env("MODEL_ID")
                or "gpt-4o-mini"
            ),
        }

    if groq_key:
        return {
            "name": "groq",
            "api_key": groq_key,
            "base_url": "https://api.groq.com/openai/v1",
            "default_model": _env("GROQ_MODEL") or "openai/gpt-oss-120b",
        }

    if fireworks_key:
        return {
            "name": "fireworks",
            "api_key": fireworks_key,
            "base_url": _env("FIREWORKS_BASE_URL")
            or "https://api.fireworks.ai/inference/v1",
            "default_model": _env("FIREWORKS_MODEL") or "accounts/fireworks/models/llama-v3p3-70b-instruct",
        }

    raise InferenceError(
        "No inference provider configured. Set ASTRA_API_KEY and ASTRA_API_ENDPOINT, or set GROQ_API_KEY or FIREWORKS_API_KEY."
    )


def chat(
    messages: list[dict[str, str]],
    *,
    model: str | None = None,
    max_tokens: int = 1200,
    temperature: float = 0.3,
    timeout: int = 90,
) -> str:
    """Send an OpenAI-compatible chat completion request."""

    provider = get_provider()

    payload: dict[str, Any] = {
        "model": model or provider["default_model"],
        "messages": messages,
        "max_tokens": max_tokens,
        "temperature": temperature,
    }

    url = provider["base_url"].rstrip("/") + "/chat/completions"

    request = urllib.request.Request(
        url,
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Authorization": f"Bearer {provider['api_key']}",
            "Content-Type": "application/json",
            "User-Agent": "Barrot/1.0",
        },
    )

    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            data = json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode("utf-8", errors="replace")[:500]
        raise InferenceError(
            f"{provider['name']} HTTP {exc.code}: {detail}"
        ) from exc
    except Exception as exc:
        raise InferenceError(
            f"{provider['name']} request failed: {exc}"
        ) from exc

    try:
        message = data["choices"][0]["message"]
        content = message.get("content") if isinstance(message, dict) else None

        if not isinstance(content, str) or not content.strip():
            raise InferenceError(
                f"{provider['name']} returned an empty completion"
            )

        return content.strip()

    except InferenceError:
        raise
    except (KeyError, IndexError, TypeError) as exc:
        raise InferenceError(
            f"Unexpected response from {provider['name']}: {str(data)[:500]}"
        ) from exc


def ask(
    prompt: str,
    *,
    system: str | None = None,
    **kwargs: Any,
) -> str:
    """Convenience wrapper for single-prompt requests."""

    messages: list[dict[str, str]] = []

    if system:
        messages.append({"role": "system", "content": system})

    messages.append({"role": "user", "content": prompt})

    return chat(messages, **kwargs)

"""""",
{"path":".env.example","content":"# B-Agent Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# Runtime environment: development | staging | production
ENVIRONMENT=development

# Enable debug mode
DEBUG=false

# Hugging Face API token (required for model download)
HF_TOKEN=

# Hugging Face model cache directory (optional)
# HF_CACHE_DIR=/path/to/cache

# Logging
LOG_LEVEL=INFO
LOG_JSON=false
# LOG_FILE=logs/b-agent.log

# Model settings (override defaults)
# MODEL__MODEL_ID=ibm-granite/granite-4.0-3b-vision
# MODEL__MAX_NEW_TOKENS=512
# MODEL__TEMPERATURE=0.7
# MODEL__LOAD_IN_8BIT=false
# MODEL__LOAD_IN_4BIT=false

# Server
HOST=0.0.0.0
PORT=8501

# Inference provider selection (default Astra when configured)
BRAIN_PRIMARY=astra
MODEL_PROVIDER=astra

# DataStax Astra / OpenAI-compatible inference
# Use either ASTRA_API_ENDPOINT or ASTRA_OPENAI_BASE_URL when your Astra deployment exposes
# an OpenAI-compatible chat endpoint. Typical values include:
#   https://<cluster-id>-<region>.apps.astra.datastax.com
#   https://<cluster-id>-<region>.apps.astra.datastax.com/api/inference
#   https://<cluster-id>-<region>.apps.astra.datastax.com/v1
ASTRA_API_KEY=
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_INFERENCE_API_KEY=
ASTRA_API_ENDPOINT=
ASTRA_OPENAI_BASE_URL=
ASTRA_MODEL=
ASTRA_MODEL_NAME=
ASTRA_INFERENCE_MODEL=

# GitHub Models (optional fallback)
GITHUB_MODEL=google/gemma-3-12b-it
GITHUB_TOKEN=
GH_MODELS_TOKEN=

# Groq remains optional and should not silently override Astra when configured.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ==========================================================================
# Kimi 3 Integration (Moonshot AI) - Recursive Feedback Loop
# ==========================================================================
# Get API key from: https://platform.moonshot.cn
KIMI__API_KEY=
KIMI__ENABLED=false
KIMI__MODEL_NAME=moonshot-v1-128k
KIMI__API_BASE=https://api.moonshot.cn/v1
KIMI__MAX_TOKENS=4096
KIMI__TEMPERATURE=0.7

# Recursive Feedback Loop Configuration
FEEDBACK_LOOP__MAX_ITERATIONS=100
FEEDBACK_LOOP__CONVERGENCE_THRESHOLD=0.95
FEEDBACK_LOOP__IMPROVEMENT_WINDOW=5
FEEDBACK_LOOP__ENABLE_AUTO_REFINEMENT=true
FEEDBACK_LOOP__REFINEMENT_INTERVAL=10
FEEDBACK_LOOP__FEEDBACK_HISTORY_LIMIT=1000

# ============================================================================
# GitHub Integration (GPT Actions & MCP Server)
# ============================================================================
# Personal access token (classic) or fine-grained PAT with repo/issues scope.
GITHUB_TOKEN=

# Default repository used when owner/repo are not supplied in the request.
GITHUB_DEFAULT_OWNER=
GITHUB_DEFAULT_REPO=

# GPT Actions HTTP server bind settings (default: 0.0.0.0:8502).
GPT_API_HOST=127.0.0.1
GPT_API_PORT=8502
"""}]}