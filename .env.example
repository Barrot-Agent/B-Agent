# B-Agent Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# Runtime environment: development | staging | production
ENVIRONMENT=development

# Enable debug mode
DEBUG=false

# Hugging Face token (optional for public models; required for gated/private models)
HF_TOKEN=

# Hugging Face model cache directory (optional)
# HF_CACHE_DIR=/path/to/cache

# Logging
LOG_LEVEL=INFO
LOG_JSON=false
# LOG_FILE=logs/b-agent.log

# Model settings (override defaults)
# MODEL__MODEL_ID=ibm-granite/granite-4.0-3b-vision
# MODEL__MAX_NEW_TOKENS=512
# MODEL__TEMPERATURE=0.7
# MODEL__LOAD_IN_8BIT=false
# MODEL__LOAD_IN_4BIT=false

# Server
HOST=0.0.0.0
PORT=8501

# GitHub Models (optional)
MODEL_PROVIDER=github
GITHUB_MODEL=google/gemma-3-12b-it
GITHUB_TOKEN=
GH_MODELS_TOKEN=
GROQ_API_KEY=

# Kimi is retained as dormant research/configuration only. The active
# recursive-feedback runtime does not instantiate or call this provider.

# Recursive Feedback Loop Configuration
FEEDBACK_LOOP__MAX_ITERATIONS=100
FEEDBACK_LOOP__CONVERGENCE_THRESHOLD=0.95
FEEDBACK_LOOP__IMPROVEMENT_WINDOW=5
FEEDBACK_LOOP__ENABLE_AUTO_REFINEMENT=true
FEEDBACK_LOOP__REFINEMENT_INTERVAL=10
FEEDBACK_LOOP__FEEDBACK_HISTORY_LIMIT=1000

# ============================================================================
# GitHub Integration (GPT Actions & MCP Server)
# ============================================================================
# Personal access token (classic) or fine-grained PAT with repo/issues scope.
GITHUB_TOKEN=

# Default repository used when owner/repo are not supplied in a request.
GITHUB_DEFAULT_OWNER=
GITHUB_DEFAULT_REPO=

# GPT Actions HTTP server bind settings (default: 0.0.0.0:8502).
GPT_API_HOST=127.0.0.1
GPT_API_PORT=8502

# ============================================================================
# Agent runtime & integrations (used by barrot_agent/*, b_agent.py, scripts/)
# ============================================================================

# GitHub push/token automation (scripts/push_with_token.sh, b_agent.py)
# GH_TOKEN is also what GitHub Actions injects automatically.
GH_TOKEN=
TARGET_REPO=Barrot-Agent/B-Agent

# GitHub App credentials (hf_space/app.py; JWT -> installation token flow)
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=

# Databricks is optional and used only by explicitly approved deployment jobs.
# Core Barrot startup and local research do not require these values.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=

# Coinbase is an optional live-exchange adapter, not the paper-trading ledger.
# Internal dry-run trading does not require these credentials or the Coinbase SDK.
COINBASE_API_KEY=
COINBASE_API_SECRET=
BARROT_MAX_TRADE_USD=
BARROT_TRADING_DRY_RUN=true

# Groq classification chain (scripts/groq_chain.py, knowledge_distill)
GROQ_MODEL=
USE_SELF_CONSISTENCY=false

# Signal pipeline inputs & HTTP timeouts (ask-barrot, content/signal fetchers)
ASK_BARROT_QUESTION=
BARROT_SIGNAL_TEXT=
BARROT_BTC_SIGNAL_TEXT=
BARROT_WORKSPACE=
ASK_HTTP_TIMEOUT=
CONTENT_HTTP_TIMEOUT=
SIGNAL_HTTP_TIMEOUT=


# External zero-cost provider fallback is disabled unless every required flag is
# explicitly set to YES after provider authentication and data-flow review.
BARROT_ENABLE_FREE_FALLBACKS=
BARROT_ALLOW_CLOUDFLARE_FREE_TIER=
BARROT_ALLOW_OPENROUTER_FREE_TIER=
BARROT_ALLOW_GEMINI_FREE_TIER=
