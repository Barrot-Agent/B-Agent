name: Barrot Router

on:
  issue_comment:
    types: [created]
  workflow_dispatch:
    inputs:
      command:
        description: "Command (example: /barrot build webmcp-v2)"
        required: true
        type: string

permissions:
  contents: write
  pull-requests: write
  issues: write

jobs:
  route:
    if: >
      github.event_name == 'workflow_dispatch' ||
      (github.event_name == 'issue_comment' &&
       contains(github.event.comment.body, '/barrot'))
    runs-on: ubuntu-latest
    outputs:
      command: ${{ steps.in.outputs.command }}
      issue_number: ${{ steps.in.outputs.issue_number }}
      mode: ${{ steps.parse.outputs.mode }}
    steps:
      - id: in
        run: |
          if [ "${{ github.event_name }}" = "workflow_dispatch" ]; then
            echo "command=${{ github.event.inputs.command }}" >> $GITHUB_OUTPUT
            echo "issue_number=" >> $GITHUB_OUTPUT
          else
            echo "command=${{ github.event.comment.body }}" >> $GITHUB_OUTPUT
            echo "issue_number=${{ github.event.issue.number }}" >> $GITHUB_OUTPUT
          fi

      - id: parse
        run: |
          CMD='${{ steps.in.outputs.command }}'
          MODE="unknown"
          echo "$CMD" | grep -Eiq '^/barrot[[:space:]]+build[[:space:]]+webmcp-v2$' && MODE="webmcp-v2"
          echo "mode=$MODE" >> $GITHUB_OUTPUT

      - name: Ack
        if: ${{ github.event_name == 'issue_comment' }}
        uses: actions/github-script@v7
        with:
          script: |
            const n = Number("${{ steps.in.outputs.issue_number }}");
            const mode = "${{ steps.parse.outputs.mode }}";
            const body = mode === "webmcp-v2"
              ? "✅ Barrot accepted: `/barrot build webmcp-v2` — starting build."
              : "⚠️ Unknown command. Use: `/barrot build webmcp-v2`";
            await github.rest.issues.createComment({
              owner: context.repo.owner, repo: context.repo.repo, issue_number: n, body
            });

  build_webmcp_v2:
    needs: route
    if: ${{ needs.route.outputs.mode == 'webmcp-v2' }}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Create branch name
        id: b
        run: echo "name=barrot/webmcp-v2-$(date +%Y%m%d-%H%M%S)" >> $GITHUB_OUTPUT

      - name: Scaffold MVP
        run: |
          mkdir -p src/routes src/services/connectors src/services/retrieval src/services/citations src/lib public .github/workflows

          cat > package.json <<'EOF'
          {
            "name": "barrot-webmcp-research-copilot",
            "version": "0.1.0",
            "private": true,
            "type": "module",
            "scripts": { "start": "node src/server.js", "dev": "node --watch src/server.js" },
            "dependencies": { "cors": "^2.8.5", "dotenv": "^16.4.5", "express": "^4.19.2", "json2csv": "^6.0.0-alpha.2" }
          }
          EOF

          cat > .env.example <<'EOF'
          PORT=3000
          NODE_ENV=development
          FREE_QUERY_LIMIT=25
          GITHUB_TOKEN=
          HUGGINGFACE_TOKEN=
          DATABRICKS_TOKEN=
          DATABRICKS_HOST=
          APP_API_KEY=
          EOF

          cat > render.yaml <<'EOF'
          services:
            - type: web
              name: barrot-webmcp
              env: node
              plan: starter
              buildCommand: npm install
              startCommand: npm start
              autoDeploy: true
          EOF

          cat > src/server.js <<'EOF'
          import express from "express"; import cors from "cors"; import dotenv from "dotenv";
          import { healthRouter } from "./routes/health.js"; import { queryRouter } from "./routes/query.js"; import { exportRouter } from "./routes/export.js";
          dotenv.config(); const app = express(); app.use(cors()); app.use(express.json({limit:"1mb"})); app.use(express.static("public"));
          app.use("/api/health", healthRouter); app.use("/api/query", queryRouter); app.use("/api/export", exportRouter);
          app.listen(process.env.PORT || 3000);
          EOF

          cat > src/routes/health.js <<'EOF'
          import { Router } from "express"; import { connectorHealth } from "../services/orchestrator.js";
          export const healthRouter = Router(); healthRouter.get("/", async (_q,res)=>res.json({ok:true,connectors:await connectorHealth()}));
          EOF

          cat > src/routes/query.js <<'EOF'
          import { Router } from "express"; import { runQuery } from "../services/orchestrator.js"; import { checkAndTrackUsage } from "../lib/usageMeter.js";
          export const queryRouter = Router();
          queryRouter.post("/", async (req,res)=>{ try{ const {query,mode="web",userId="anon"}=req.body||{}; if(!query)return res.status(400).json({ok:false,error:"query is required"});
          const usage=checkAndTrackUsage(userId); if(!usage.allowed)return res.status(402).json({ok:false,error:"free_limit_reached"});
          const result=await runQuery({query,mode}); res.json({ok:true,usage,...result}); }catch(e){res.status(500).json({ok:false,error:"query_failed"});} });
          EOF

          cat > src/routes/export.js <<'EOF'
          import { Router } from "express"; import { Parser } from "json2csv";
          export const exportRouter = Router(); exportRouter.post("/csv",(req,res)=>{ const csv=new Parser().parse(req.body?.rows||[]);
          res.setHeader("Content-Type","text/csv"); res.setHeader("Content-Disposition","attachment; filename=barrot-export.csv"); res.send(csv); });
          EOF

          cat > src/services/orchestrator.js <<'EOF'
          import { githubSearch } from "./connectors/github.js"; import { huggingFaceSearch } from "./connectors/huggingface.js"; import { databricksSearch } from "./connectors/databricks.js";
          import { lexicalRetrieve } from "./retrieval/lexical.js"; import { semanticRetrieve } from "./retrieval/semantic.js"; import { rerank } from "./retrieval/rerank.js"; import { formatCitations } from "./citations/formatter.js";
          export async function runQuery({query,mode}){ const all=[...(await lexicalRetrieve(query,mode)),...(await semanticRetrieve(query,mode)),...(await githubSearch(query)),...(await huggingFaceSearch(query)),...(await databricksSearch(query))];
          const top=rerank(all).slice(0,8); return {mode,answer:`Top findings for "${query}"`,results:top,citations:formatCitations(top),confidence:Math.min(0.95,0.55+top.length*0.03)}; }
          export async function connectorHealth(){ return { github:!!process.env.GITHUB_TOKEN, huggingface:!!process.env.HUGGINGFACE_TOKEN, databricks:!!(process.env.DATABRICKS_TOKEN&&process.env.DATABRICKS_HOST)}; }
          EOF

          cat > src/services/connectors/github.js <<'EOF'
          export async function githubSearch(query){ if(!process.env.GITHUB_TOKEN)return []; return [{source:"github",title:`GitHub signal for: ${query}`,url:"https://github.com",score:0.60}]; }
          EOF

          cat > src/services/connectors/huggingface.js <<'EOF'
          export async function huggingFaceSearch(query){ if(!process.env.HUGGINGFACE_TOKEN)return []; return [{source:"huggingface",title:`HF signal for: ${query}`,url:"https://huggingface.co",score:0.58}]; }
          EOF

          cat > src/services/connectors/databricks.js <<'EOF'
          export async function databricksSearch(query){ if(!process.env.DATABRICKS_TOKEN||!process.env.DATABRICKS_HOST)return []; return [{source:"databricks",title:`Databricks signal for: ${query}`,url:process.env.DATABRICKS_HOST,score:0.57}]; }
          EOF

          cat > src/services/retrieval/lexical.js <<'EOF'
          export async function lexicalRetrieve(query,mode){ return [{source:mode,title:`Lexical hit: ${query}`,url:"https://example.com/lexical",score:0.52}]; }
          EOF

          cat > src/services/retrieval/semantic.js <<'EOF'
          export async function semanticRetrieve(query,mode){ return [{source:mode,title:`Semantic hit: ${query}`,url:"https://example.com/semantic",score:0.56}]; }
          EOF

          cat > src/services/retrieval/rerank.js <<'EOF'
          export function rerank(items){ return [...items].sort((a,b)=>(b.score||0)-(a.score||0)); }
          EOF

          cat > src/services/citations/formatter.js <<'EOF'
          export function formatCitations(results){ return results.map((r,i)=>({id:i+1,title:r.title,url:r.url,source:r.source})); }
          EOF

          cat > src/lib/usageMeter.js <<'EOF'
          const usage=new Map(); export function checkAndTrackUsage(userId){ const limit=Number(process.env.FREE_QUERY_LIMIT||25); const next=(usage.get(userId)||0)+1; usage.set(userId,next); return {userId,used:next,limit,allowed:next<=limit}; }
          EOF

          cat > public/index.html <<'EOF'
          <!doctype html><html><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Barrot WebMCP</title><link rel="stylesheet" href="/styles.css"/></head>
          <body><main><h1>Barrot WebMCP Research Copilot</h1><div class="row"><input id="query" placeholder="Ask anything..."/><select id="mode"><option value="web">Web</option><option value="code">Code</option><option value="data">Data</option></select><button id="go">Search</button></div><pre id="out"></pre></main><script src="/app.js"></script></body></html>
          EOF

          cat > public/app.js <<'EOF'
          const go=document.getElementById("go"),out=document.getElementById("out");
          go.onclick=async()=>{const query=document.getElementById("query").value,mode=document.getElementById("mode").value;const r=await fetch("/api/query",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({query,mode,userId:"founder"})});out.textContent=JSON.stringify(await r.json(),null,2);};
          EOF

          cat > public/styles.css <<'EOF'
          body{font-family:Arial,sans-serif;margin:2rem}.row{display:flex;gap:.5rem;margin:1rem 0}input{flex:1;padding:.6rem}select,button{padding:.6rem}pre{background:#111;color:#0f0;padding:1rem;border-radius:8px;overflow:auto}
          EOF

          cat > README.md <<'EOF'
          # Barrot WebMCP Search v2 MVP
          npm install && cp .env.example .env && npm run dev
          Endpoints: GET /api/health | POST /api/query | POST /api/export/csv
          EOF

      - uses: peter-evans/create-pull-request@v6
        with:
          branch: ${{ steps.b.outputs.name }}
          title: "feat: launch WebMCP search v2 MVP with connectors, citations, export, and deploy config"
          commit-message: "feat: launch WebMCP search v2 MVP with connectors, citations, export, and deploy config"
          body: "Auto-generated from /barrot build webmcp-v2 command."
          labels: automation,webmcp

      - name: Comment done
        if: ${{ needs.route.outputs.issue_number != '' }}
        uses: actions/github-script@v7
        with:
          script: |
            await github.rest.issues.createComment({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: Number("${{ needs.route.outputs.issue_number }}"),
              body: "🚀 Build done. PR created."
            });
