{
  "mcpServers": {
    "barrot-core-repository": {
      "command": "uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "."
      ],
      "env": {
        "XRP_ENV": "production",
        "STABILITY_ANCHOR": "0.707"
      },
      "_note": "Run from the repository root; the git server scopes itself to the current directory."
    },
    "barrot-memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {
        "MEMORY_FILE_PATH": "ping-pongings/knowledge-base/barrot_memory.jsonl"
      }
    },
    "barrot-filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ]
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_MCP_TOKEN}"
      },
      "_requires_approval": true,
      "_note": "Official GitHub remote MCP. Token comes from the OpenCode service env (opencode service set env GITHUB_MCP_TOKEN)."
    },
    "docling": {
      "command": "uvx",
      "args": [
        "--from",
        "docling-mcp[local]",
        "docling-mcp-server",
        "--transport",
        "stdio"
      ],
      "env": {
        "DOCLING_MCP_CONVERSION_MODE": "local",
        "UV_LINK_MODE": "copy"
      },
      "_note": "PDF/DOCX/HTML conversion with OCR. First cold start downloads the Docling stack."
    },
    "searxng": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-searxng"
      ],
      "env": {
        "SEARXNG_URL": "http://127.0.0.1:8888"
      },
      "_note": "Requires the local SearXNG instance: bash scripts/start_searxng.sh --daemon"
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "sandbox"
      ],
      "_note": "Read-only access scoped to ./sandbox. Write ops require approval."
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"],
      "_note": "Read-only HTTP fetch. No auth required."
    }
  },
  "_integration_framework": {
    "version": "1.1.0",
    "entry_point": "barrot_agent.mcp_integration.MCPIntegration",
    "default_dry_run": true,
    "approval_required_for": [
      "install",
      "repo_write",
      "workflow_execution",
      "production_deploy",
      "registry_promote"
    ],
    "registry_path": "barrot_agent/mcp_registry.json",
    "provenance_path": "barrot_agent/mcp_provenance.jsonl"
  }
}
