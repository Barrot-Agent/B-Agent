{
  "mcpServers": {
    "barrot-core-repository": {
      "command": "uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "/workspace/B-Agent"
      ],
      "env": {
        "XRP_ENV": "production",
        "STABILITY_ANCHOR": "0.707"
      }
    },
    "barrot-memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {
        "MEMORY_FILE_PATH": "/workspace/B-Agent/ping-pongings/knowledge-base/barrot_memory.jsonl"
      }
    },
    "barrot-filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/workspace/B-Agent"
      ]
    }
  }
}
