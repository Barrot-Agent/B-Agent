{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "barrot",
  "model": "opencode/deepseek-v4.1-flash-free",
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_MCP_TOKEN}"
        },
        "timeout": {
          "startup": 60000
        }
      },
      "docling": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "docling-mcp[local]",
          "docling-mcp-server",
          "--transport",
          "stdio"
        ],
        "environment": {
          "DOCLING_MCP_CONVERSION_MODE": "local",
          "UV_LINK_MODE": "copy"
        },
        "timeout": {
          "startup": 240000,
          "catalog": 120000
        }
      },
      "searxng": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "mcp-searxng"
        ],
        "environment": {
          "SEARXNG_URL": "http://127.0.0.1:8888"
        },
        "timeout": {
          "startup": 90000
        }
      },
      "barrot": {
        "type": "local",
        "command": [
          "python3",
          "scripts/barrot_mcp_server.py"
        ],
        "timeout": {
          "startup": 30000
        },
        "environment": {
          "BARROT_A2A_URL": "https://barrot-a2a-worker.amazonprostarelite.workers.dev"
        }
      }
    }
  },
  "permission": {
    "external_directory": "allow",
    "edit": "allow",
    "bash": "allow"
  }
}
