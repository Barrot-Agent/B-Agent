{
  "$schema": "https://opencode.ai/config.json",
  "model": "lunaroute/glm-5.3-flash",
  "provider": {
    "lunaroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LunaRoute",
      "options": {
        "baseURL": "https://gw.lunaroute.com/v1",
        "apiKey": "{env:LUNAROUTE_API_KEY}"
      },
      "models": {
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash"
        },
        "deepseek-4.1-flash": {
          "name": "DeepSeek 4.1 Flash"
        },
        "muse-spark-open": {
          "name": "Muse Spark Open"
        }
      }
    }
  }
}
