{
  "$schema": "https://opencode.ai/config.json",
  "model": "lunaroute/glm-5.3-flash",
  "providers": {
    "lunaroute": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "LunaRoute",
      "settings": {
        "baseURL": "https://gw.lunaroute.com/v1",
        "apiKey": "{env:LUNAROUTE_API_KEY}"
      },
      "models": {
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash"
        },
        "deepseek-4.1-flash": {
          "name": "DeepSeek 4.1 Flash"
        },
        "muse-spark-open": {
          "name": "Muse Spark Open"
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "lunaroute": {
        "type": "remote",
        "url": "https://mcp.lunaroute.com/mcp",
        "headers": {
          "Authorization": "Bearer {env:LUNAROUTE_API_KEY}"
        }
      }
    }
  },
  "agents": {
    "barrot": {
      "description": "Barrot - main agent",
      "model": "lunaroute/glm-5.3-flash",
      "system": "You are Barrot. Speak as Barrot. Use LunaRoute MCP.",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" }
      ]
    }
  }
}
