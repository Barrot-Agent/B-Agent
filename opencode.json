{
  "$schema": "https://opencode.ai/config.json",
  "model": "lunaroute/glm-5.3-flash",
  "provider": {
    "lunaroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LunaRoute",
      "options": {
        "baseURL": "https://gw.lunaroute.com/v1",
        "apiKey": "{env:LUNAROUTE_API_KEY}"
      },
      "models": {
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash"
        },
        "deepseek-4.1-flash": {
          "name": "DeepSeek 4.1 Flash"
        },
        "muse-spark-open": {
          "name": "Muse Spark Open"
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "lunaroute": {
        "type": "remote",
        "url": "https://mcp.lunaroute.com/mcp",
        "disabled": true,
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:LUNAROUTE_API_KEY}"
        }
      }
    }
  },
  "agent": {
    "barrot": {
      "description": "Barrot - main agent",
      "model": "lunaroute/glm-5.3-flash",
      "prompt": "Use LunaRoute MCP only after it is explicitly enabled and authentication, tool permissions, and data-flow have been verified. Never claim a live connection without verification.",
      "permission": {
        "*": "ask",
        "edit": "ask",
        "bash": "ask",
        "webfetch": "ask",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "skill": "allow",
        "question": "allow"
      }
    }
  }
}
