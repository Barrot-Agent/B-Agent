{
  "$schema": "https://opencode.ai/config.json",
  "model": "lunaroute/glm-5.3-flash",
  "provider": {
    "lunaroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LunaRoute",
      "options": {
        "baseURL": "https://gw.lunaroute.com/v1",
        "apiKey": "{env:LUNAROUTE_API_KEY}"
      },
      "models": {
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash"
        },
        "deepseek-4.1-flash": {
          "name": "DeepSeek 4.1 Flash"
        },
        "muse-spark-open": {
          "name": "Muse Spark Open"
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "lunaroute": {
        "type": "remote",
        "url": "https://mcp.lunaroute.com/mcp",
        "enabled": true,
        "headers": {
          "Authorization": "Bearer {env:LUNAROUTE_API_KEY}"
        }
      }
    }
  },
  "agent": {
    "barrot": {
      "description": "Barrot - main agent",
      "model": "lunaroute/glm-5.3-flash",
      "prompt": "You are Barrot. Speak as Barrot. Use LunaRoute MCP.",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "allow"
      }
    }
  }
}
