{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "barrot",
  "model": "opencode/deepseek-v4.1-flash-free",
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_MCP_TOKEN}"
        },
        "timeout": {
          "startup": 60000
        }
      },
      "docling": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "docling-mcp[local]",
          "docling-mcp-server",
          "--transport",
          "stdio"
        ],
        "environment": {
          "DOCLING_MCP_CONVERSION_MODE": "local",
          "UV_LINK_MODE": "copy"
        },
        "timeout": {
          "startup": 240000,
          "catalog": 120000
        }
      },
      "searxng": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "mcp-searxng"
        ],
        "environment": {
          "SEARXNG_URL": "http://127.0.0.1:8888"
        },
        "timeout": {
          "startup": 90000
        }
      },
      "barrot": {
        "type": "local",
        "command": [
          "python3",
          "scripts/barrot_mcp_server.py"
        ],
        "timeout": {
          "startup": 30000
        }
      },
      "lunaroute": {
        "type": "remote",
        "url": "https://mcp.lunaroute.com/mcp",
        "disabled": true,
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:LUNAROUTE_API_KEY}"
        }
      }
    }
  },
  "permission": {
    "external_directory": "ask",
    "edit": "ask",
    "bash": "ask",
    "webfetch": "ask"
  },
  "provider": {
    "lunaroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LunaRoute",
      "options": {
        "baseURL": "https://gw.lunaroute.com/v1",
        "apiKey": "{env:LUNAROUTE_API_KEY}"
      },
      "models": {
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash"
        },
        "deepseek-4.1-flash": {
          "name": "DeepSeek 4.1 Flash"
        },
        "muse-spark-open": {
          "name": "Muse Spark Open"
        }
      }
    }
  },
  "agent": {
    "barrot": {
      "description": "Barrot - main agent",
      "model": "opencode/deepseek-v4.1-flash-free",
      "prompt": "Use only providers with tested authentication and data-flow. The default OpenCode free model is the verified configuration. LunaRoute remains optional/unverified and its MCP server is disabled; do not claim a live connection or send data through it until explicitly authorized and verified. Preserve Barrot V3 and follow the XRP mission readiness gates.",
      "permission": {
        "*": "ask",
        "edit": "ask",
        "bash": "ask",
        "webfetch": "ask",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "skill": "allow",
        "question": "allow"
      }
    }
  }
}
