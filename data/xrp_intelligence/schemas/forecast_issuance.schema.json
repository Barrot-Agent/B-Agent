{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://barrot-agent.github.io/B-Agent/data/xrp_intelligence/schemas/forecast_issuance.schema.json",
  "title": "Immutable XRP Forecast Issuance Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "forecast_id", "issued_at_utc", "data_cutoff_utc", "asset", "target", "horizon_seconds", "target_definition", "probabilities", "probability_status", "feature_snapshot_sha256", "source_manifest_sha256", "model_version", "assumptions", "alternatives", "baseline_model_ids", "resolution_protocol"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "forecast_issuance"},
    "forecast_id": {"type": "string", "minLength": 1},
    "issued_at_utc": {"type": "string", "format": "date-time"},
    "data_cutoff_utc": {"type": "string", "format": "date-time"},
    "asset": {"const": "XRP"},
    "target": {"const": "XRP_USD_DIRECTION"},
    "horizon_seconds": {"type": "integer", "minimum": 1},
    "target_definition": {"type": "string", "minLength": 10},
    "probabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["UP", "DOWN", "FLAT"],
      "properties": {
        "UP": {"type": "number", "minimum": 0, "maximum": 1},
        "DOWN": {"type": "number", "minimum": 0, "maximum": 1},
        "FLAT": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "probability_status": {"enum": ["CALIBRATED", "UNCALIBRATED"]},
    "calibration_artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "feature_snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "model_version": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "alternatives": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "baseline_model_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "resolution_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_source_id", "start_price_definition", "end_price_definition", "neutral_band_bps", "horizon_tolerance_seconds"],
      "properties": {
        "reference_source_id": {"type": "string", "minLength": 1},
        "start_price_definition": {"type": "string", "minLength": 1},
        "end_price_definition": {"type": "string", "minLength": 1},
        "neutral_band_bps": {"type": "number", "minimum": 0},
        "horizon_tolerance_seconds": {"type": "integer", "minimum": 0}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"probability_status": {"const": "CALIBRATED"}}, "required": ["probability_status"]},
      "then": {"required": ["calibration_artifact_sha256"]},
      "else": {"not": {"required": ["calibration_artifact_sha256"]}}
    }
  ]
}