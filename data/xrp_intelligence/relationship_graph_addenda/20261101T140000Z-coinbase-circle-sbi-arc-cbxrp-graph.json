  "competing_hypotheses": [
    {
      "id": "H1_coinbase_multistablecoin_platform",
      "claim": "Coinbase is pursuing a multi-issuer distribution/custody/credit strategy rather than exclusive Circle alignment.",
      "support": [
        "Circle arrangement renewed on same terms",
        "RLUSD listed on Coinbase",
        "cbXRP collateral loans and USDC credit product",
