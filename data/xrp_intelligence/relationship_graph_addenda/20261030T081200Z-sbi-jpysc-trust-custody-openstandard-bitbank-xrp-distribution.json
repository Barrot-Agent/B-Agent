      "counter": [
        "CoinDesk's crosswalk identifies Ethereum Binance 14, not the five XRP accounts.",
        "CoinLaw summary does not display an XRP ratio.",
        "Official Binance October 1 address payload remains unparsed."
      ],
      "status": "UNRESOLVED"
    },
    {
      "id": "HYP-XRP-POSTHACK-VOLUNTARY-EXCHANGE-OUTFLOW-20261030",
