  "competing_hypotheses": [
    {
      "id": "HYP-SBI-MULTIRAIL-DIGITAL-ASSET-STACK-20261030",
      "claim": "SBI is assembling a multi-rail digital-asset financial stack in which XRP is one distribution and ecosystem component, not the exclusive settlement asset.",
      "support": [
        "Bitbank acquisition and XRP/JPY market.",
        "SBI Visa Crypto Card and START bond XRP incentives.",
        "SBI VC Trade distribution of both RLUSD and USDC.",
        "SBI Ripple Asia XRPL startup support.",
        "JPYSC, Open Standard interoperability consideration, tokenized-MMF MOU and trust consolidation."
      ],
      "counter": [
        "JPYSC/OUSD and tokenized-MMF routes are not XRP-specific.",
        "No XRP custody balances, actual card reward distribution or post-acquisition XRP trading growth are disclosed."
      ],
      "status": "STRONGLY_SUPPORTED_GROUP_STRATEGY; XRP_VALUE_CAPTURE_UNMEASURED"
    },
    {
      "id": "HYP-SBI-BITBANK-XRP-LIQUIDITY-EXPANSION-20261030",
      "claim": "SBI's full acquisition of Bitbank could increase Japanese XRP/JPY distribution and liquidity through a larger group customer base.",
      "support": [
        "Bitbank acquisition completed October 1.",
        "Bitbank lists XRP/JPY with observable spot volume and order-book depth."
      ],
      "counter": [
        "No post-acquisition before/after volume series, customer migration or group-wide XRP holdings are available."
      ],
      "status": "CHANNEL_CONFIRMED; INCREMENTAL_LIQUIDITY_EFFECT_UNMEASURED"
    },
    {
      "id": "HYP-SBI-XRP-RETAIL-INCENTIVE-DISTRIBUTION-20261030",
      "claim": "SBI has used XRP incentives to route traditional retail finance customers into SBI VC Trade.",
      "support": [
        "Visa Crypto Card allows point conversion to XRP.",
        "SBI START bond offered XRP reward and sold out."
      ],
      "counter": [
        "Total XRP credited is not disclosed.",
        "START bond reward was a limited one-time incentive; later coupon rewards were undecided and not promised.",
        "No evidence of net new exchange purchases or persistent retail demand."
      ],
      "status": "PRODUCTS_CONFIRMED; AGGREGATE_XRP_FLOW_UNKNOWN"
    },
    {
      "id": "HYP-JPYSC-OUSD-ALTERNATIVE-SETTLEMENT-RAIL-20261030",
      "claim": "JPYSC/OUSD interoperability could create an alternative JPY/USD settlement route alongside USDC and RLUSD.",
      "support": [
        "SBI and Startale joined Open Standard and are considering a PoC.",
        "SBI VC Trade already distributes USDC and RLUSD.",
        "OUSD is live on Base, Ethereum, Solana and Tempo."
      ],
      "counter": [
        "No live PoC, selected chain, bridge, production volume or XRPL route is disclosed.",
        "JPYSC initially remained account-bound."
      ],
      "status": "POTENTIAL_ROUTE_NOT_OPERATIONAL"
    },
    {
      "id": "HYP-OUSD-PARTNER-ECONOMICS-CHALLENGE-CIRCLE-20261030",
      "claim": "Open Standard's partner-shared reserve economics could challenge Circle's issuer-centric USDC economics, while Coinbase and Ripple participate in the wider network.",
      "support": [
        "Coinbase is an Open Standard founding partner.",
        "The Block reports Ripple among broader participants.",
        "Stripe/Open Standard describes partner rewards and no mint/burn fees."
      ],
      "counter": [
        "No evidence Coinbase or Ripple has shifted USDC/RLUSD volume to OUSD at scale.",
        "Circle is not listed among the five founders, but this does not prove direct commercial displacement.",
        "OUSD and USDC may serve different distribution/use cases."
      ],
      "status": "COMPETITIVE_HYPOTHESIS; DISPLACEMENT_NOT_ESTABLISHED"
    },
    {
      "id": "HYP-SBI-TRUST-CONSOLIDATION-CUSTODY-EXPANSION-20261030",
      "claim": "The planned SBI Clearing Trust merger could consolidate crypto-asset custody and stablecoin trust capabilities within SBI Shinsei Trust Bank.",
      "support": [
        "SBI Clearing Trust began crypto-asset trust business in July 2023.",
        "October 29 merger agreement names SBI Shinsei Trust as survivor and includes JPYSC issuance."
      ],
      "counter": [
        "Merger is subject to regulatory approvals and not effective until planned December 31.",
        "No XRP-specific trust asset, customer balance or custody mandate is disclosed."
      ],
      "status": "PLANNED_CAPABILITY_CONSOLIDATION; XRP_SCOPE_UNKNOWN"
    },
    {
      "id": "HYP-BINANCE-XRP-POR-IMPAIRMENT-20261030",
      "claim": "The five compromised Binance XRPL source wallets were part of the October 1 XRP PoR reserve set.",
      "support": [
        "Bitquery labels drained wallets with Binance PoR tags."
