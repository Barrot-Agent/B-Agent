  "hypotheses": [
    {
      "id": "HYP-SBI-DCA-RECURRING-XRP-DEMAND",
      "claim": "SBI VC Trade's scheduled accumulation product can create recurring customer-funded XRP purchase demand when customers select XRP and maintain sufficient JPY balances.",
      "status": "PURCHASE_MECHANISM_CONFIRMED; ACTUAL_XRP_ORDERS_AND_MARKET_IMPACT_UNKNOWN",
      "support": [
        "Official product terms specify XRP eligibility, scheduled frequencies, JPY order limits and required prefunding."
      ],
      "disconfirming": [
        "No active-plan counts, filled XRP units, execution venue or external sourcing is disclosed.",
        "Insufficient balance can skip orders; the dealer may internalize or source inventory away from public spot books."
      ],
      "next_test": "Obtain XRP-specific plan counts, monthly JPY order/fill totals and execution/inventory reconciliation."
    },
    {
      "id": "HYP-SBI-RETAIL-DISTRIBUTION-ONBOARDING",
      "claim": "SBI Group's card and multi-affiliate shareholder-benefit programs may expand XRP ownership and onboard customers into SBI VC Trade.",
      "status": "DISTRIBUTION_MECHANISMS_CONFIRMED; ADOPTION_AND_NET_CAPITAL_UNQUANTIFIED",
      "support": [
        "Five SBI entities documented XRP shareholder benefits; receipt requires an SBI VC Trade account.",
        "The card converts points into selected crypto-assets, including XRP.",
        "SBI Insurance Group explicitly describes improving awareness and understanding of the SBI Group as a program objective."
      ],
      "disconfirming": [
        "No participant counts, XRP selection shares, coupon redemptions or XRP units credited are disclosed.",
        "Some benefits are optional and can be exchanged for non-crypto products.",
        "Rewards may be fulfilled from existing inventory rather than new market purchases."
      ],
      "next_test": "Obtain eligible-holder counts, redemption rates, XRP units credited and inventory source-of-funds records."
    },
    {
      "id": "HYP-SBI-REWARD-INVENTORY-NOT-SPOT-BUY",
      "claim": "Card points and shareholder XRP coupons may be fulfilled through existing dealer inventory or internal transfers without equivalent contemporaneous public-market buying.",
      "status": "PLAUSIBLE_COUNTERHYPOTHESIS; INVENTORY_SOURCE_UNKNOWN",
      "support": [
        "Reward conversion uses an SBI VC Trade displayed sales-price reference, not a disclosed external execution record.",
        "The programs specify fixed JPY benefit values and same-name account credits."
      ],
      "disconfirming": [
        "If SBI VC Trade replenishes inventory externally, some reward fulfillment could induce spot or OTC demand; no procurement evidence is published."
      ],
      "next_test": "Reconcile reward liabilities, treasury inventory and exchange/OTC purchase records over the benefit settlement windows."
    }
  ]
}
