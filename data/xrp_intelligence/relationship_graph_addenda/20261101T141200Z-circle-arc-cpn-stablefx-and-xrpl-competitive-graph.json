  "hypotheses": [
    {
      "id": "ARC_AS_XRPL_COMPETITOR",
      "claim": "Arc's USDC-native gas, StableFX and CPN may compete with XRPL/Ripple Payments for some institutional payment and FX settlement flows.",
      "status": "plausible_inference",
      "required_evidence": [
        "Arc transaction and settlement volumes",
        "XRPL stablecoin payment and DEX volumes",
        "institutional customer routing and corridor data"
      ]
    },
    {
      "id": "ARC_AS_MULTICHAIN_COMPLEMENT",
      "claim": "Arc may complement XRPL because Circle issues USDC natively on XRPL and Ripple has stated it intends to use USDC alongside RLUSD.",
      "status": "plausible_inference",
      "required_evidence": [
        "cross-chain USDC flows",
        "institutional routing data",
        "actual settlement destination shares"
      ]
    },
    {
      "id": "USDC_GAS_SUBSTITUTES_XRP_GAS",
      "claim": "USDC gas on Arc removes the need to hold a volatile native token for Arc transaction fees, but does not prove substitution for XRP outside Arc.",
      "status": "confirmed_design_fact_with_limited_market_implication"
    }
  ],
  "red_team_objections": [
    "Do not equate announced validator or exchange participation with production usage.",
    "Do not infer XRP demand from USDC on XRPL or Arc integrations without measured routing and volume.",
    "Do not classify Arc as an exclusive competitor; Circle's USDC is also available on XRPL."
  ]
