  "hypotheses": [
    {
      "id": "H1",
      "statement": "XRP is a recognized digital commodity and is accepted as collateral at a CFTC-registered DCO; this creates real institutional collateral utility.",
      "classification": "CONFIRMED_WITH_SCOPE_LIMITS",
      "support": [
        "Joint SEC/CFTC interpretation names XRP as a digital commodity.",
        "Bitnomial schedule lists XRP at 40% haircut/$15M limit.",
        "Bitnomial XRP futures products are CFTC-certified."
      ],
      "counterpoints": [
        "No customer-level collateral balances disclosed.",
        "Venue schedule is restrictive.",
        "No universal FCM or DCO acceptance."
      ]
    },
    {
      "id": "H2",
      "statement": "CFTC Letter 26-05 can extend XRP collateral access to other FCMs after their initial period if XRP is accepted by a registered DCO and the FCM files notice.",
      "classification": "CONDITIONAL_REGULATORY_PATHWAY",
      "support": [
        "Coinbase Financial Markets originated the request.",
        "Letter references DCO-accepted non-security assets and DCO haircuts.",
        "XRP is named as digital commodity and Bitnomial accepts it."
      ],
      "counterpoints": [
        "No Coinbase notice or actual XRP use verified.",
        "No proof of Coinbase clearing through Bitnomial."
      ]
    },
    {
      "id": "H3",
      "statement": "Payward's acquisition of Bitnomial creates a competitive advantage in US regulated derivatives and XRP collateral infrastructure.",
      "classification": "STRONGLY_SUPPORTED_STRATEGIC_INFERENCE",
      "support": [
        "Payward owns FCM/DCM/DCO stack.",
        "Bitnomial's XRP products are CFTC-certified and XRP is on its collateral schedule."
      ],
      "counterpoints": [
        "No market-share, customer collateral or revenue data."
      ]
    },
    {
      "id": "H4",
      "statement": "RLUSD remains accepted by Bitnomial.",
