  "hypotheses": [
    {
      "id": "H-INSTITUTIONAL-CUSTODY-ACCESS",
      "claim": "BNY custody support and effective trust-bank charters reduce operational barriers to institutional holding and servicing of XRP/RLUSD.",
      "status": "SUPPORTED_AS_INFRASTRUCTURE_ACCESS_NOT_DEMAND",
      "supporting": [
        "BNY says it supports XRP and RLUSD custody.",
        "OCC CAS records show Ripple and Circle trust-bank charters effective on 2026-10-26 and 2026-07-24."
      ],
      "disconfirming": [
        "No client XRP balances, custody AUM, operating launch metrics or new net XRP purchases are disclosed."
      ]
    },
    {
      "id": "H-C2FO-ACTUAL-CAPITAL",
      "claim": "C2FO Instant Pay may route actual supplier-financing capital through XRPL with RLUSD settlement.",
      "status": "ANNOUNCED_DESIGN_WAITLIST_NOT_LIVE_VOLUME",
      "supporting": [
        "Ripple/C2FO say participating capital providers fund instant supplier payments and XRPL/RLUSD settle them.",
        "C2FO has an existing platform-wide early-payment history."
      ],
      "disconfirming": [
        "Instant Pay waitlist is the stated availability path; no XRPL funded invoice or settlement volume is disclosed.",
        "The USD 520B figure belongs to existing C2FO Early Pay programs, not XRPL Instant Pay."
      ]
    },
    {
      "id": "H-AVIVA-TOKENIZED-FUND",
      "claim": "A launched Aviva tokenized liquidity-fund share class establishes a live institutional fund asset on XRPL.",
      "status": "CONFIRMED_LAUNCH; CAPITAL_SCALE_UNKNOWN",
      "supporting": [
        "Aviva confirms launch on XRPL and CBI approval.",
        "Komainu, Licuido and BNY roles are identified."
      ],
      "disconfirming": [
        "Tokenized share-class AUM, holdings, investor count and secondary turnover are not disclosed.",
        "This is not evidence of XRP collateral or material XRP spot demand."
      ]
    },
    {
      "id": "H-EURCV-COLLATERAL",
      "claim": "EUR CoinVertible could become trading collateral in Ripple products.",
      "status": "FUTURE_OPPORTUNITY_ONLY",
      "supporting": [
        "SG-FORGE confirms EURCV launched on XRPL with Ripple custody support."
      ],
      "disconfirming": [
        "SG-FORGE describes collateral use as an opportunity to explore; no live collateral integration or balances are disclosed."
      ]
    },
    {
      "id": "H-XRP-DIRECT-DEMAND",
      "claim": "These custody, trust-bank and tokenized-finance relationships prove net XRP buying or a directional price catalyst.",
      "status": "UNSUPPORTED_NO_FEATURE_ADMISSION",
      "supporting": [],
      "disconfirming": [
        "RLUSD and EURCV are issued stablecoins; Aviva fund shares are tokenized fund interests; custody support is not a proprietary purchase.",
        "No XRP net-flow, collateral balance, funded trade-finance volume or XRP purchase quantity is disclosed."
      ]
    }
  ],
  "limitations": [
    "Effective OCC charter status is not proof of a bank's operational opening or live customer services.",
    "RLUSD remains issued by Standard Custody & Trust Company; Ripple National Trust Bank is not the issuer.",
    "BNY custody platform support does not disclose client balances or imply BNY is buying XRP.",
    "C2FO's historical USD 520B Early Pay figure is not XRPL activity and must not be attributed to Instant Pay.",
    "Aviva's tokenized fund share class is live, but AUM, investor count and on-chain turnover are not disclosed.",
    "SG-FORGE collateral use and Mastercard/WebBank/Gemini settlement remain exploratory in the cited announcements."
  ]
