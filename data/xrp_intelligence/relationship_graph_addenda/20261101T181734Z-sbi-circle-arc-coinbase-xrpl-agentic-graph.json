  "competing_hypotheses": [
    {
      "id": "H1_SBI_multirail",
      "hypothesis": "SBI Group is building a multi-rail institutional strategy rather than choosing a single XRP or USDC network.",
      "supporting_evidence": [
        "SBI Group is a Circle Arc founding validator and says it will leverage USDC and JPYSC.",
        "SBI VC Trade distributes USDC and RLUSD in Japan.",
        "SBI Remit uses XRP in selected remittance corridors."
      ],
      "disconfirming_or_missing": [
        "No current throughput by rail is disclosed.",
        "No evidence of exclusive commitment or net XRP accumulation from these initiatives."
      ]
    },
    {
      "id": "H2_Arc_competes_for_stablecoin_and_agentic_flows",
      "hypothesis": "Circle Arc may capture stablecoin-native payments, FX, lending and agentic settlement that might otherwise use XRPL.",
      "supporting_evidence": [
        "Arc uses USDC as gas and has a large institutional/exchange/credit cohort.",
        "Circle reports USDC at 98.8% of agent-driven transaction volume."
      ],
      "disconfirming_or_missing": [
        "Circle USDC is natively available on XRPL.",
        "Coinbase, Circle, Ripple and t54 share x402 Foundation participation.",
        "No chain-level flow evidence demonstrates displacement from XRPL."
      ]
    },
    {
      "id": "H3_XRPL_x402_is_utility_but_not_material_XRP_demand",
      "hypothesis": "XRPL x402 is technically operational but current monetary settlement value is too small to establish material XRP market demand.",
      "supporting_evidence": [
        "T54 reports about 14.83M payment/settlement events but only $48.3K cumulative value.",
        "The facilitator supports both XRP and RLUSD, so event counts are not necessarily XRP-denominated."
      ],
      "disconfirming_or_missing": [
        "Raw ledger-level event-to-invoice reconciliation has not been independently completed.",
        "The dashboard and third-party tracker disagree on counts and merchant/service totals."
      ]
    },
    {
      "id": "H4_RLUSD_distribution_center_shift",
      "hypothesis": "RLUSD's distribution is currently more Ethereum-centered than XRPL-centered.",
      "supporting_evidence": [
        "XRP Insights reports $707.4M on XRPL versus $1.71B on Ethereum, approximately 29% versus 71%."
      ],
      "disconfirming_or_missing": [
        "Raw issuer gateway_balances and Ethereum totalSupply were not independently retrieved in this run.",
        "The chain split has changed historically; a single snapshot does not establish durable migration or redemption causality."
      ]
    },
    {
      "id": "H5_exchange_outflows_signal_supply_migration",
      "hypothesis": "The seven-day decline in attributed exchange wallets may reflect XRP moving to self-custody or other venues.",
      "supporting_evidence": [
        "Same-wallet attributed balances declined approximately 161.1M XRP over seven days."
      ],
      "disconfirming_or_missing": [
        "Thirty-day same-wallet change is only about -12.7M XRP.",
        "Unattributed wallet transfers, internal cold-wallet movements and coverage changes prevent a customer-withdrawal conclusion."
      ]
    },
    {
      "id": "H6_ETF_inflows_signal_sticky_institutional_interest",
      "hypothesis": "Positive weekly ETF/index flows despite a tracker-estimated cost basis above spot may indicate persistent allocation interest.",
      "supporting_evidence": [
        "Tracker reports +3.39M XRP net weekly flow and approximately 1.1966B XRP holdings."
      ],
      "disconfirming_or_missing": [
        "Weekly flow is small relative to holdings.",
        "GXRP flows are excluded and some historical rows are reconstructed.",
        "The estimated average cost is not issuer-reported investor cost basis."
      ]
    }
  ],
  "unresolved_no_edge_assertions": [
    "No direct commercial or ownership relationship between Tokyo SBIC and SBI Holdings has been established.",
    "No evidence shows Circle's 98.8% agent-payment claim represents all x402 activity across all chains.",
    "No evidence shows Circle Arc uses XRP as its native gas or collateral asset.",
    "No evidence shows x402 payment-event counts translate into net XRP purchases."
  ]
