{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Barrot-Agent/B-Agent/blob/main/data/xrp_intelligence/platform_evidence_packet.schema.json",
  "title": "Barrot XRP Platform Evidence Packet",
  "description": "Common evidence contract for independent platform tasks; adapter status and permissions must be evidence-backed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_id",
    "created_at_utc",
    "data_cutoff_utc",
    "platform",
    "status",
    "auth_state",
    "permission_scope",
    "task",
    "source_records",
    "claims",
    "causal_hypotheses",
    "disagreement",
    "red_team_review",
    "handoff",
    "security"
  ],
  "properties": {
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "data_cutoff_utc": {
      "type": "string",
      "format": "date-time"
    },
    "platform": {
      "type": "string",
      "enum": [
        "ChatGPT",
        "Claude",
        "Grok",
        "Gemini",
        "Copilot",
        "Codex",
        "Hugging Face",
        "Kaggle",
        "Databricks"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "DESIGNED",
        "EXECUTED",
        "VERIFIED",
        "BLOCKED"
      ]
    },
    "auth_state": {
      "type": "string",
      "enum": [
        "VERIFIED_IN_SESSION",
        "VERIFIED_API",
        "NOT_CONFIGURED",
        "NOT_TESTED",
        "FAILED"
      ]
    },
    "permission_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "granted",
        "requested",
        "denied"
      ],
      "properties": {
        "granted": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "public_read",
              "repository_read",
              "branch_write",
              "pr_write"
            ]
          }
        },
        "requested": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "public_read",
              "repository_read",
              "branch_write",
              "pr_write",
              "merge",
              "deploy",
              "trade"
            ]
          }
        },
        "denied": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "merge",
              "deploy",
              "trade",
              "private_data",
              "secrets"
            ]
          }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "question",
        "assigned_role",
        "independent",
        "allowed_source_classes",
        "prohibited_actions"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "assigned_role": {
          "type": "string",
          "minLength": 1
        },
        "independent": {
          "type": "boolean"
        },
        "allowed_source_classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prohibited_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "source_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "publisher",
          "url",
          "source_type",
          "retrieved_at_utc",
          "evidence_class",
          "independence_class",
          "terms_review"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "source_type": {
            "type": "string"
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "retrieved_at_utc": {
            "type": "string",
            "format": "date-time"
          },
          "evidence_class": {
            "type": "string",
            "enum": [
              "PRIMARY",
              "SECONDARY",
              "DERIVED",
              "INTERNAL_TEST",
              "UNKNOWN"
            ]
          },
          "independence_class": {
            "type": "string"
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "terms_review": {
            "type": "string"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "statement",
          "classification",
          "source_ids",
          "confidence",
          "supporting_evidence",
          "disconfirming_evidence",
          "assumptions",
          "unknowns"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "classification": {
            "type": "string",
            "enum": [
              "CONFIRMED_FACT",
              "SOURCED_CLAIM",
              "INFERENCE",
              "SPECULATION",
              "UNKNOWN",
              "DISCONFIRMED"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "supporting_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "disconfirming_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unknowns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "causal_hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hypothesis_id",
          "statement",
          "alternatives",
          "discriminating_tests",
          "confidence"
        ],
        "properties": {
          "hypothesis_id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "discriminating_tests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "disagreement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alternatives_considered",
        "minority_objections",
        "resolution_method",
        "resolution_status"
      ],
      "properties": {
        "alternatives_considered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "minority_objections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resolution_method": {
          "type": "string"
        },
        "resolution_status": {
          "type": "string",
          "enum": [
            "RESOLVED",
            "PARTIAL",
            "UNRESOLVED",
            "NO_DISAGREEMENT"
          ]
        }
      }
    },
    "red_team_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewer_platform",
        "objections",
        "counter_hypotheses"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "NOT_RUN",
            "PENDING",
            "PASS",
            "FAIL"
          ]
        },
        "reviewer_platform": {
          "type": "string",
          "enum": [
            "ChatGPT",
            "Claude",
            "Grok",
            "Gemini",
            "Copilot",
            "Codex",
            "Hugging Face",
            "Kaggle",
            "Databricks",
            "none"
          ]
        },
        "objections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "counter_hypotheses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_snapshot_sha256",
        "output_sha256",
        "tests",
        "verified_by",
        "verification_status",
        "errors"
      ],
      "properties": {
        "input_snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "output_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "status",
              "evidence_url"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "PENDING",
                  "NOT_RUN"
                ]
              },
              "evidence_url": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "verified_by": {
          "type": "string",
          "enum": [
            "ChatGPT",
            "Claude",
            "Grok",
            "Gemini",
            "Copilot",
            "Codex",
            "Hugging Face",
            "Kaggle",
            "Databricks",
            "none"
          ]
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "NOT_VERIFIED",
            "VERIFIED",
            "FAILED"
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "forecast": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_cutoff_utc",
        "horizon",
        "target",
        "assumptions",
        "probability",
        "alternatives",
        "confidence",
        "model_version",
        "outcome_due_at_utc",
        "outcome_status"
      ],
      "properties": {
        "data_cutoff_utc": {
          "type": "string",
          "format": "date-time"
        },
        "horizon": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "outcome_due_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "outcome_status": {
          "type": "string",
          "enum": [
            "PENDING",
            "SCORED",
            "CENSORED",
            "NOT_ISSUED"
          ]
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_or_authorized_sources_only",
        "private_data_used",
        "secrets_in_packet",
        "unauthorized_access",
        "market_manipulation",
        "real_money_action",
        "external_action"
      ],
      "properties": {
        "public_or_authorized_sources_only": {
          "const": true
        },
        "private_data_used": {
          "const": false
        },
        "secrets_in_packet": {
          "const": false
        },
        "unauthorized_access": {
          "const": false
        },
        "market_manipulation": {
          "const": false
        },
        "real_money_action": {
          "const": false
        },
        "external_action": {
          "type": "string",
          "enum": [
            "none",
            "approved_branch_or_pr_write"
          ]
        }
      }
    }
  }
}
