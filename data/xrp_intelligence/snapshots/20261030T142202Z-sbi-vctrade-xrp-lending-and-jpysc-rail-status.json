apshot_blob_sha":"f0d9d149ae345dcf39f2b1702b4301e1e27e8042","snapshot_commit_sha":"52a2dc489c697616753e0926c5cf40dd689ced5e"}}}}}}}}}}}}}}}}}}}}},"source_ids":["SRC-SBI-VCTRADE-LENDING-XRP-20261030","SRC-SBI-VCTRADE-JPYSC-TRANSFER-RESTRICTION-20261030","SRC-SBI-VCTRADE-USDC-RLUSD-ETHEREUM-CHAIN-FAQ-20261030","SRC-SBI-VCTRADE-RLUSD-ETHEREUM-ONLY-XRPL-PLANNED-20261030","SRC-JPYSC-ACCOUNT-ONLY-PUBLIC-CHAIN-PLANNED-20260624","SRC-SBI-VCTRADE-USDC-ETHEREUM-ONLY-DEPOSIT-2026","SRC-CIRCLE-USDC-NATIVE-XRPL-LAUNCH-20250612","SRC-RIPPLE-CIRCLE-USDC-XRPL-PARTNERSHIP-20250612"],"confirmed_facts":[{"claim":"SBI VC Trade's lending (Kashikoin) product lists XRP, USDC and JPYSC among 32 supported assets. The customer lends the asset to SBI VC Trade under a consumption-loan arrangement; the same asset plus fee is returned at maturity. The product page says early termination is unavailable and course-specific rates/terms vary.","source_ids":["SRC-SBI-VCTRADE-LENDING-XRP-20261030"],"evidence_class":"PRIMARY_PRODUCT_DISCLOSURE"},{"claim":"The SBI VC Trade lending page does not disclose XRP loan balances, borrower demand, utilization, rehypothecation or an XRP-specific rate. Its 10% example is for a specific USDC course dated 2026-04-30, not XRP.","source_ids":["SRC-SBI-VCTRADE-LENDING-XRP-20261030"],"evidence_class":"PRIMARY_PRODUCT_DISCLOSURE_LIMITATION"},{"claim":"JPYSC is issued by SBI Shinsei Trust Bank and developed by SBI Holdings and Startale Group. SBI VC Trade states that JPYSC deposits and withdrawals are currently unsupported; public-chain circulation is conditional on legal/tax treatment and supervisory confirmation.","source_ids":["SRC-SBI-VCTRADE-JPYSC-TRANSFER-RESTRICTION-20261030"],"evidence_class":"PRIMARY_PRODUCT_DISCLOSURE"},{"claim":"SBI VC Trade's JPYSC product page lists Ethereum as the service network but explicitly states that external deposits and withdrawals are not enabled. JPYSC is currently confined to SBI VC Trade accounts.","source_ids":["SRC-SBI-VCTRADE-JPYSC-TRANSFER-RESTRICTION-20261030","SRC-JPYSC-ACCOUNT-ONLY-PUBLIC-CHAIN-PLANNED-20260624"],"evidence_class":"PRIMARY_NETWORK_AND_TRANSFER_DISCLOSURE"},{"claim":"The current VCTRADE route matrix lists native XRP deposits/withdrawals on XRPL; USDC and RLUSD on Ethereum; RLUSD's XRPL support as planned, not live; and JPYSC external deposits/withdrawals as unsupported.","source_ids":["SRC-SBI-VCTRADE-USDC-RLUSD-ETHEREUM-CHAIN-FAQ-20261030","SRC-SBI-VCTRADE-RLUSD-ETHEREUM-ONLY-XRPL-PLANNED-20261030","SRC-JPYSC-ACCOUNT-ONLY-PUBLIC-CHAIN-PLANNED-20260624"],"evidence_class":"PRIMARY_VENUE_SPECIFIC_NETWORK_MATRIX"},{"claim":"Circle's USDC is natively deployed on XRPL, but SBI VC Trade's current USDC route supports Ethereum only. Issuer-level XRPL deployment does not establish SBI VC Trade XRPL deposit/withdrawal support.","source_ids":["SRC-CIRCLE-USDC-NATIVE-XRPL-LAUNCH-20250612","SRC-RIPPLE-CIRCLE-USDC-XRPL-PARTNERSHIP-20250612","SRC-SBI-VCTRADE-USDC-ETHEREUM-ONLY-DEPOSIT-2026"],"evidence_class":"PRIMARY_ISSUER_AND_VENUE_ROUTE_RECONCILIATION"}],"inferences":["SBI VC Trade offers an internal XRP custody/lending channel in addition to XRP spot trading and XRPL transfers. This could create borrowable XRP inventory, but no public utilization, borrower, loan balance or XRP-specific rate is disclosed.","JPYSC is not yet a public-chain settlement rail through SBI VC Trade. Its Ethereum network designation is prospective/operationally constrained because external transfers are disabled.","SBI's current VCTRADE route matrix is multi-rail but fragmented: native XRP on XRPL; USDC/RLUSD on Ethereum; JPYSC account-only. This does not create a single demonstrated XRPL stablecoin-to-XRP settlement path at this venue."],"competing_hypotheses":[{"hypothesis_id":"HYP-SBI-VCTRADE-XRP-LENDING-CUSTODY-CHANNEL-20261030","claim":"SBI VC Trade's XRP lending product may create an off-chain custody and borrowable-supply channel that affects XRP availability and lending economics.","supporting_source_ids":["SRC-SBI-VCTRADE-LENDING-XRP-20261030"],"counterevidence":"No XRP outstanding loan balance, borrower demand, utilization, lending rate, rehypothecation or settlement data is public in the reviewed page.","status":"PRODUCT_CONFIRMED_UTILIZATION_UNKNOWN"},{"hypothesis_id":"HYP-JPYSC-PUBLIC-RAIL-ACTIVATION-20261030","claim":"JPYSC may eventually become a public-chain settlement rail and connect to tokenized assets or stablecoin networks.","supporting_source_ids":["SRC-SBI-VCTRADE-JPYSC-TRANSFER-RESTRICTION-20261030"],"counterevidence":"SBI currently disables external deposits/withdrawals and says public-chain circulation awaits legal/tax treatment and supervisory confirmation.","status":"FUTURE_OPTION_NOT_LIVE"}],"unknowns":["XRP lending balances outstanding at SBI VC Trade and their distribution across customers/borrowers.","Actual XRP lending rates, course availability, loan utilization, collateral requirements and rehypothecation policy.","Whether XRP borrowed through SBI VC Trade is used for market-making, customer short positions, OTC settlement or other purposes.","The date when JPYSC external transfers will be enabled and which public chain will be used.","Whether SBI VC Trade will add XRPL support for USDC or RLUSD; RLUSD XRPL support remains listed as planned."],"disconfirming_evidence":[{"claim":"The existence of an XRP lending product does not establish outstanding XRP loans, actual institutional utilization or price impact.","source_ids":["SRC-SBI-VCTRADE-LENDING-XRP-20261030"]},{"claim":"JPYSC is not externally transferable through SBI VC Trade at present, so account balances cannot be counted as public-chain circulating supply or XRPL payment volume.","source_ids":["SRC-SBI-VCTRADE-JPYSC-TRANSFER-RESTRICTION-20261030"]},{"claim":"Circle's native USDC deployment on XRPL does not change SBI VC Trade's venue-specific Ethereum-only USDC route.","source_ids":["SRC-CIRCLE-USDC-NATIVE-XRPL-LAUNCH-20250612","SRC-SBI-VCTRADE-USDC-ETHEREUM-ONLY-DEPOSIT-2026"]}],"market_observations":[{"observation_id":"MOBS-SBI-VCTRADE-XRP-LENDING-ELIGIBILITY-20261030","as_of":"2026-10-30T14:22:02Z","asset":"XRP","venue":"SBI VC Trade","observation":"XRP listed among 32 assets eligible for Kashikoin lending","outstanding_balance":"NOT_DISCLOSED","utilization":"NOT_DISCLOSED","rate":"COURSE_SPECIFIC_NOT_DISCLOSED","source_ids":["SRC-SBI-VCTRADE-LENDING-XRP-20261030"],"feature_status":"PRODUCT_AVAILABILITY_CONTEXT_ONLY"},{"observation_id":"MOBS-SBI-JPYSC-EXTERNAL-TRANSFER-STATUS-20261030","as_of":"2026-10-30T14:22:02Z","asset":"JPYSC","venue":"SBI VC Trade","external_deposit":false,"external_withdrawal":false,"service_network":"Ethereum listed; external circulation disabled","source_ids":["SRC-SBI-VCTRADE-JPYSC-TRANSFER-RESTRICTION-20261030"],"feature_status":"PUBLIC_CHAIN_FLOW_ZERO_OR_UNAVAILABLE_NOT_ADMITTED_AS_MARKET_FEATURE"}],"route_matrix":{"venue":"SBI VC Trade VCTRADE","observed_at_utc":"2026-10-30T14:22:02Z","assets":[{"asset":"XRP","network":"XRPL","deposit":"SUPPORTED","withdrawal":"SUPPORTED","lending":"SUPPORTED"},{"asset":"USDC","network":"Ethereum","deposit":"SUPPORTED","withdrawal":"SUPPORTED_PER_NETWORK_FAQ","lending":"SUPPORTED"},{"asset":"RLUSD","network":"Ethereum","deposit":"SUPPORTED","withdrawal":"SUPPORTED_PER_NETWORK_FAQ","xrpl":"PLANNED_NOT_LIVE"},{"asset":"JPYSC","network":"Ethereum listed","deposit":"NOT_SUPPORTED","withdrawal":"NOT_SUPPORTED","lending":"SUPPORTED_ACCOUNT_SIDE"}],"scope_limit":"SBI VC Trade VCTRADE only; not all SBI Group affiliates or third-party venues."},"market_features_admitted":false,"forecast_status":"NOT_ISSUED"}