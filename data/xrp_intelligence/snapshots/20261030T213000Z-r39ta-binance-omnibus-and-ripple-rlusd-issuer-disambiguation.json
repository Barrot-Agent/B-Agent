  "findings": [
    {
      "classification": "CONFIRMED_LEDGER_BALANCE_SEQUENCE",
      "statement": "The 20M XRP receipt at 20:16:10 UTC raised r39TA from about 5.868M to 25.868M XRP; two payments to Binance-labelled rNxp4h at 20:47:00 and 20:47:20 delivered 19,999,197.11 XRP and left about 5.869M XRP. The account-level sequence is confirmed; same-unit provenance and purpose are not."
    },
    {
      "classification": "STRONG_EXCHANGE_WALLET_PATTERN_INFERENCE",
      "statement": "rNxp4h receives many small, destination-tagged deposits from Bitso, Uphold, Bitget and other senders. This is consistent with a shared Binance exchange deposit/omnibus account and weakens the claim that the 20M deposit was a reserve replenishment."
    },
    {
      "classification": "ISSUER_SENDER_DISAMBIGUATION",
      "statement": "A 10M RLUSD payment to r39TA came from unlabelled rnhSfm. The raw transaction identifies Ripple's RLUSD issuer address, but rnhSfm's account profile is unlabelled and activated by an unlabelled account. The transfer must not be attributed to Ripple the company."
    }
  ],
  "competing_hypotheses": [
