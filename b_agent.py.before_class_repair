class GroqLLM:
    ENDPOINT = "https://api.groq.com/openai/v1/chat/completions"

    def __init__(
        self,
        api_key,
        model="openai/gpt-oss-20b",
        temperature=0.2,
    ):
        self.model = model
        self.temperature = temperature
        self.client = httpx.Client(
            headers={
                "Authorization": f"Bearer {api_key}",
                "Content-Type": "application/json",
            },
            timeout=120.0,
        )

    def chat(self, messages):
        MAX_MESSAGE_CHARS = 7000
        MAX_TOTAL_CHARS = 12000

        compact_messages = []
        remaining = MAX_TOTAL_CHARS

        # Preserve the newest messages first because they contain the
        # current user request and immediate task context.
        for message in reversed(messages):
            role = message.get("role", "user")
            content = str(message.get("content", ""))

            if len(content) > MAX_MESSAGE_CHARS:
                content = content[-MAX_MESSAGE_CHARS:]

            if remaining <= 0:
                break

            if len(content) > remaining:
                content = content[-remaining:]

            compact_messages.append({
                "role": role,
                "content": content,
            })

            remaining -= len(content)

        compact_messages.reverse()

        response = self.client.post(
            "/chat/completions",
            json={
                "model": self.model,
                "messages": compact_messages,
                "temperature": 0.2,
            },
        )

        response.raise_for_status()

        payload = response.json()
        return payload["choices"][0]["message"]["content"]

    def __init__(self, token, full_name):
        self.full_name = full_name
        self.client = httpx.Client(
            headers={
                "Authorization": f"Bearer {token}",
                "Accept": "application/vnd.github+json",
                "X-GitHub-Api-Version": "2022-11-28",
            },
            timeout=60.0,
        )

        response = self.client.get(
            f"{self.API}/repos/{self.full_name}"
        )
        response.raise_for_status()

        self.repo = response.json()
        self.default_branch = self.repo["default_branch"]

    def _url(self, path=""):
        return (
            f"{self.API}/repos/{self.full_name}"
            f"{path}"
        )

    def get_tree(self, ref=None):
        ref = ref or self.default_branch

        response = self.client.get(
            self._url(
                f"/git/trees/{ref}"
                "?recursive=1"
            )
        )
        response.raise_for_status()

        tree = response.json()["tree"]

        return [
            (item["path"], item["sha"])
            for item in tree
            if item["type"] == "blob"
        ]

    def read_file(self, path, ref=None):
        ref = ref or self.default_branch

        response = self.client.get(
            self._url(
                f"/contents/{path}"
                f"?ref={ref}"
            )
        )
        response.raise_for_status()

        data = response.json()

        return base64.b64decode(
            data["content"]
        ).decode("utf-8")

    def get_branch_sha(self, branch):
        response = self.client.get(
            self._url(
                f"/git/ref/heads/{branch}"
            )
        )

        if response.status_code == 404:
            return None

        response.raise_for_status()

        return response.json()["object"]["sha"]

    def ensure_branch(
        self,
        branch,
        base=None,
    ):
        existing = self.get_branch_sha(branch)

        if existing:
            log.info(
                "Branch %s already exists",
                branch,
            )
            return

        base = base or self.default_branch

        base_sha = self.get_branch_sha(base)

        response = self.client.post(
            self._url("/git/refs"),
            json={
                "ref": f"refs/heads/{branch}",
                "sha": base_sha,
            },
        )

        response.raise_for_status()

        log.info(
            "Created branch %s",
            branch,
        )

    def commit_file(
        self,
        path,
        content,
        branch,
        message,
    ):
        url = self._url(f"/contents/{path}")

        existing = self.client.get(
            url,
            params={"ref": branch},
        )

        payload = {
            "message": message,
            "content": base64.b64encode(
                content.encode("utf-8")
            ).decode("ascii"),
            "branch": branch,
        }

        if existing.status_code == 200:
            payload["sha"] = (
                existing.json()["sha"]
            )
        elif existing.status_code != 404:
            existing.raise_for_status()

        response = self.client.put(
            url,
            json=payload,
        )

        response.raise_for_status()

        return response.json()

    def open_pr(
        self,
        head,
        base=None,
        title="",
        body="",
    ):
        base = base or self.default_branch

        response = self.client.post(
            self._url("/pulls"),
            json={
                "title": (
                    title
                    or f"[B-Agent] {head}"
                ),
                "head": head,
                "base": base,
                "body": (
                    body
                    or "Generated by B-Agent."
                ),
            },
        )

        response.raise_for_status()

        return response.json()["html_url"]

    def merge_pr(
        self,
        pr_number,
        commit_title=None,
    ):
        response = self.client.put(
            self._url(
                f"/pulls/{pr_number}/merge"
            ),
            json={
                "commit_title": (
                    commit_title
                    or "Merge B-Agent changes"
                ),
            },
        )

        response.raise_for_status()

        return response.json()


SYSTEM_PROMPT = """
You are B-Agent, an autonomous software engineer.

Analyze repository code and help implement requested
features, fixes, and refactors.

When asked to make changes:

1. Give a concise plan.
2. When the user says "go ahead", return ONLY valid JSON.
3. The JSON must map repository file paths to complete
   file contents.

Example:

{
  "path/to/file.py": "complete file contents",
  "another/file.txt": "complete contents"
}

Never include markdown fences around the JSON.
"""



def build_repo_context(
    repo,
    limit=None,
    max_file_chars=2500,
    max_total_chars=18000,
):
    tree = repo.get_tree()

    excluded_prefixes = (
        ".barrot-backup/",
        ".git/",
        "node_modules/",
        "__pycache__/",
        ".pytest_cache/",
        ".mypy_cache/",
        ".venv/",
        "venv/",
        "dist/",
        "build/",
        "feedback_loops/",
        "data/",
    )

    source_exts = {
        ".py", ".js", ".ts", ".tsx", ".jsx",
        ".json", ".yaml", ".yml", ".toml",
        ".ini", ".cfg", ".md", ".sh",
    }

    priority_names = {
        "pyproject.toml",
        "setup.py",
        "requirements.txt",
        "README.md",
        "package.json",
        "Dockerfile",
    }

    selected = []

    for path, _ in tree:
        if path.startswith(excluded_prefixes):
            continue

        name = Path(path).name
        suffix = Path(path).suffix.lower()

        if name in priority_names:
            selected.append((0, path))
        elif path.startswith("barrot_agent/"):
            selected.append((1, path))
        elif path.startswith("tests/"):
            selected.append((2, path))
        elif path.startswith(".github/workflows/"):
            selected.append((4, path))
        elif suffix in source_exts:
            selected.append((3, path))

    selected.sort()

    # HARD LIMIT: prevents massive repository payloads.
    if limit is None:
        limit = 24

    selected = [path for _, path in selected[:limit]]

    files = []
    total = 0

    for path in selected:
        if total >= max_total_chars:
            break

        try:
            content = repo.read_file(path)

            content = content[:max_file_chars]

            block = (
                f"\n\n===== FILE: {path} =====\n"
                f"{content}"
            )

            remaining = max_total_chars - total

            if len(block) > remaining:
                block = block[:remaining]

            files.append(block)
            total += len(block)

        except Exception as exc:
            files.append(
                f"\n===== FILE: {path} =====\n"
                f"[READ FAILED: {exc}]"
            )

    filtered_paths = [
        path
        for path, _ in tree
        if not path.startswith(excluded_prefixes)
    ]

    tree_listing = "\n".join(filtered_paths[:500])

    return (
        f"REPOSITORY: {repo.full_name}\n"
        f"DEFAULT BRANCH: {repo.default_branch}\n"
        f"TOTAL FILES: {len(tree)}\n"
        f"FILES ANALYZED: {len(selected)}\n\n"
        f"===== FILE TREE =====\n"
        f"{tree_listing[:8000]}\n\n"
        f"===== FILE CONTENT ====="
        f"{''.join(files)}"
    )

def run_repository_audit(repo, llm):
    tree = repo.get_tree()

    excluded_prefixes = (
        ".barrot-backup/",
        ".git/",
        "node_modules/",
        "__pycache__/",
        ".venv/",
        "venv/",
        "dist/",
        "build/",
        "data/",
    )

    active_paths = [
        path
        for path, _ in tree
        if not path.startswith(excluded_prefixes)
    ]

    # Keep the first request extremely small.
    tree_listing = "\n".join(active_paths[:250])

    audit_prompt = """Perform a FIRST-PASS repository architecture audit.

You are receiving the repository file tree only. Do not claim detailed
code-level facts that cannot be proven from the tree.

Identify:

1. Major architectural boundaries
2. Duplicate or overlapping subsystems
3. Packaging structure
4. Agent/orchestration structure
5. CI/CD workflow concentration
6. Likely source versus generated/backup areas
7. Missing or unclear entry points

Return:

A. VERIFIED STRUCTURAL FACTS
B. HIGH-PRIORITY AREAS REQUIRING DEEPER INSPECTION
C. NEXT FIVE FILE GROUPS TO INSPECT

Repository file tree:

""" + tree_listing[:12000]

    return llm.chat([
        {
            "role": "system",
            "content": (
                "You are an evidence-based software architecture "
                "auditor. Never invent repository facts."
            ),
        },
        {
            "role": "user",
            "content": audit_prompt,
        },
    ])


class GitHubRepo:
    def __init__(
        self,
        token=None,
        repo_name=None,
        full_name=None,
        **kwargs,
    ):
        import os
        import base64

        self._base64 = base64

        # Accept multiple constructor styles.
        self.full_name = (
            full_name
            or repo_name
            or kwargs.get("repo")
            or kwargs.get("repository")
            or kwargs.get("name")
        )

        if not self.full_name:
            raise ValueError(
                "GitHub repository name is required."
            )

        self.token = (
            token
            or kwargs.get("github_token")
            or os.getenv("GITHUB_TOKEN")
            or os.getenv("GH_TOKEN")
        )

        headers = {
            "Accept": (
                "application/vnd.github+json"
            ),
            "X-GitHub-Api-Version": (
                "2022-11-28"
            ),
        }

        if self.token:
            headers[
                "Authorization"
            ] = f"Bearer {self.token}"

        # httpx is already used by b_agent.py.
        import httpx

        self.client = httpx.Client(
            base_url="https://api.github.com",
            headers=headers,
            timeout=60.0,
        )

        response = self.client.get(
            f"/repos/{self.full_name}"
        )
        response.raise_for_status()

        metadata = response.json()

        self.default_branch = metadata.get(
            "default_branch",
            "main",
        )

    def get_tree(self):
        response = self.client.get(
            (
                f"/repos/{self.full_name}"
                f"/git/trees/{self.default_branch}"
            ),
            params={
                "recursive": "1",
            },
        )

        response.raise_for_status()

        tree = response.json().get(
            "tree",
            [],
        )

        return [
            (
                item.get("path"),
                item.get("type"),
            )
            for item in tree
            if item.get("type") == "blob"
            and item.get("path")
        ]

    def read_file(self, path):
        response = self.client.get(
            (
                f"/repos/{self.full_name}"
                f"/contents/{path}"
            ),
            params={
                "ref": self.default_branch,
            },
        )

        response.raise_for_status()

        payload = response.json()

        content = payload.get(
            "content",
            "",
        )

        encoding = payload.get(
            "encoding",
            "",
        )

        if encoding == "base64":
            content = self._base64.b64decode(
                content
            ).decode(
                "utf-8",
                errors="replace",
            )

        return content

    def close(self):
        self.client.close()

def main():
    parser = argparse.ArgumentParser()

    parser.add_argument(
        "--auto-merge",
        action="store_true",
    )

    parser.add_argument(
        "--model",
        default=os.getenv(
            "GROQ_MODEL",
            "openai/gpt-oss-20b",
        ),
    )

    args = parser.parse_args()

    repo = GitHubRepo(
        GH_TOKEN,
        TARGET_REPO,
    )

    llm = GroqLLM(
        GROQ_API_KEY,
        args.model,
    )

    console.print(
        f"[green]Connected to "
        f"{repo.full_name}[/green]"
    )

    console.print(
        "[yellow]Running evidence-based repository audit...[/yellow]"
    )

    audit = run_repository_audit(
        repo,
        llm,
    )

    audit_path = Path(
        "data/repository_architecture_audit.md"
    )

    audit_path.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    audit_path.write_text(
        audit,
        encoding="utf-8",
    )

    console.print(
        f"[green]Audit saved to {audit_path}[/green]"
    )

    console.print(
        Markdown(audit)
    )


    console.print(
        "[yellow]Starting autonomous repository repair loop...[/yellow]"
    )

    repair_report = run_repository_repair_loop(
        repo=repo,
        llm=llm,
        workspace=".",
        output_dir="data/repository_repair",
        max_subsystems=3,
    )

    console.print(
        "[bold green]"
        "REPOSITORY REPAIR LOOP COMPLETE"
        "[/bold green]"
    )

    context = build_repo_context(
        repo,
        max_total_chars=120000,
    )

    messages = [
        {
            "role": "system",
            "content": SYSTEM_PROMPT,
        },
        {
            "role": "system",
            "content": context,
        },
    ]

    while True:
        user_input = Prompt.ask(
            "[bold cyan]You[/bold cyan]"
        ).strip()

        if user_input.lower() in {
            "exit",
            "quit",
        }:
            break

        messages.append(
            {
                "role": "user",
                "content": user_input,
            }
        )

        answer = llm.chat(messages)

        messages.append(
            {
                "role": "assistant",
                "content": answer,
            }
        )

        try:
            changes = json.loads(answer)
        except json.JSONDecodeError:
            console.print(Markdown(answer))
            continue

        if not isinstance(changes, dict):
            console.print(Markdown(answer))
            continue

        if not all(
            isinstance(path, str)
            and isinstance(content, str)
            for path, content in changes.items()
        ):
            console.print(Markdown(answer))
            continue

        branch = (
            "b-agent/"
            + datetime.now().strftime(
                "%Y%m%d-%H%M%S"
            )
        )

        repo.ensure_branch(branch)

        console.print(
            f"[yellow]Applying "
            f"{len(changes)} file change(s)...[/yellow]"
        )

        for path, content in changes.items():
            repo.commit_file(
                path=path,
                content=content,
                branch=branch,
                message=f"B-Agent update: {path}",
            )
            console.print(
                f"[green]Updated:[/green] {path}"
            )

        pr_url = repo.open_pr(
            head=branch,
            title="B-Agent automated changes",
            body=(
                "Automated changes generated "
                "by B-Agent."
            ),
        )

        console.print(
            f"[bold green]PR CREATED:[/bold green] "
            f"{pr_url}"
        )

        if args.auto_merge:
            pr_response = repo.client.get(
                pr_url.replace(
                    "https://github.com/",
                    "https://api.github.com/repos/"
                ).replace(
                    "/pull/",
                    "/pulls/"
                )
            )

            if pr_response.status_code == 200:
                pr_number = (
                    pr_response.json()["number"]
                )

                merge_result = repo.merge_pr(
                    pr_number
                )

                console.print(
                    "[bold green]"
                    "AUTO-MERGE RESULT:"
                    "[/bold green]"
                )
                console.print(
                    json.dumps(
                        merge_result,
                        indent=2,
                    )
                )


if __name__ == "__main__":
    main()
